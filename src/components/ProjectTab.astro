---
import { Image } from "astro:assets";
import ArrowRight from "@lucide/astro/icons/arrow-right";

const { title, description, logo, link, loading, width } = Astro.props;
---

<div class="project-tab flex flex-col gap-5 relative">
  <a
    href={link}
    class="rounded-3xl p-4 w-sm md:w-lg flex items-center gap-3 bg-slate-800 relative overflow-hidden"
  >
    <div
      class="viewPill p-3 bg-slate-900 text-slate-200 flex gap-5 items-center rounded-lg pl-5 w-28 h-16"
    >
      <p>View</p>
      <p><ArrowRight /></p>
    </div>
    <div class="logo">
      <Image
        src={logo}
        height="75"
        alt="Bloom Academy Logo"
        class="rounded-3xl"
        loading={loading}
      />
    </div>
    <div class="text-content">
      <h3 class="text-base">{title}</h3>
      <p class="text-slate-500">{description}</p>
    </div>
  </a>
</div>

<script src="../scripts/projectTabs.js"></script>
