---
import { Image } from "astro:assets";

const { title, description, logo, link } = Astro.props;
---

<div id="box"></div>

<div class="flex flex-col gap-5">
  <a
    href={link}
    class="rounded-3xl p-4 w-lg flex items-center gap-3 bg-slate-800"
  >
    <div id="logo" class="">
      <Image
        src={logo}
        height="75"
        alt="Bloom Academy Logo"
        class="rounded-3xl"
        loading="eager"
      />
    </div>
    <div id="text-content" class="">
      <h3 class="text-base">{title}</h3>
      <p class="text-slate-500">{description}</p>
    </div>
  </a>

